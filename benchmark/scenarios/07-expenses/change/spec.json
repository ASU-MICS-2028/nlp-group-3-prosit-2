{
 "project_name": "Household Expenses",
 "description": "A tracker where a household records what it spends, by category.",
 "roles": [
  "user",
  "admin"
 ],
 "entities": [
  {
   "name": "Category",
   "description": "A kind of spending, e.g. food.",
   "fields": [
    {
     "name": "name",
     "type": "str",
     "unique": true
    },
    {
     "name": "monthly_budget",
     "type": "float",
     "required": false,
     "description": "optional spending limit"
    }
   ]
  },
  {
   "name": "Expense",
   "description": "Money that was spent.",
   "belongs_to": [
    "Category"
   ],
   "fields": [
    {
     "name": "category_id",
     "type": "int"
    },
    {
     "name": "amount",
     "type": "float"
    },
    {
     "name": "spent_on",
     "type": "date"
    },
    {
     "name": "note",
     "type": "str",
     "required": false
    }
   ]
  }
 ],
 "endpoints": [
  {
   "method": "POST",
   "path": "/categories",
   "summary": "Add a category",
   "entity": "Category",
   "access": "user",
   "request_fields": [
    "name",
    "monthly_budget"
   ],
   "status_code": 201
  },
  {
   "method": "GET",
   "path": "/categories",
   "summary": "List categories",
   "entity": "Category",
   "access": "user",
   "status_code": 200
  },
  {
   "method": "DELETE",
   "path": "/categories/{id}",
   "summary": "Delete a category",
   "entity": "Category",
   "access": "admin",
   "status_code": 204
  },
  {
   "method": "POST",
   "path": "/expenses",
   "summary": "Record an expense",
   "entity": "Expense",
   "access": "user",
   "request_fields": [
    "category_id",
    "amount",
    "spent_on",
    "note"
   ],
   "status_code": 201
  },
  {
   "method": "GET",
   "path": "/expenses",
   "summary": "List expenses",
   "entity": "Expense",
   "access": "user",
   "status_code": 200
  },
  {
   "method": "GET",
   "path": "/expenses/{id}",
   "summary": "Get an expense",
   "entity": "Expense",
   "access": "user",
   "status_code": 200
  },
  {
   "method": "PUT",
   "path": "/expenses/{id}",
   "summary": "Replace an expense",
   "entity": "Expense",
   "access": "user",
   "request_fields": [
    "category_id",
    "amount",
    "spent_on",
    "note"
   ],
   "status_code": 200
  },
  {
   "method": "DELETE",
   "path": "/expenses/{id}",
   "summary": "Delete an expense",
   "entity": "Expense",
   "access": "user",
   "status_code": 204
  },
  {
   "method": "GET",
   "path": "/summary",
   "summary": "Total spent and number of expenses: {\"total\": float, \"count\": int}",
   "entity": null,
   "access": "user",
   "status_code": 200
  }
 ],
 "rules": [
  "amount must be greater than 0; reject with 422.",
  "A category that has expenses cannot be deleted; reject with 409.",
  "GET /summary returns a JSON object with total (the sum of all expense amounts, 0 when there are none) and count (the number of expenses).",
  "category_id must refer to an existing category; otherwise 404.",
  "monthly_budget is optional; when given it must be greater than 0, otherwise reject with 422.",
  "GET /summary also returns by_category: a list with one object (category_id, name, total) for each category that has expenses, where total is the sum of that category's expense amounts."
 ]
}
