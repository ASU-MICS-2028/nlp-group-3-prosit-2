# gemini | claude | claude-code
LLM_PROVIDER=gemini
GEMINI_API_KEY=...
# LLM_MODEL=gemini-3.8-flash
# LLM_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash   (used when the main model is overloaded/out of quota)
# claude-code: uses your local `claude` CLI login (Claude subscription), no key. LLM_MODEL=sonnet|opus|haiku
# claude: ANTHROPIC_API_KEY=sk-ant-...   (paid API credits)
